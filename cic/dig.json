                  ["M1","^Y$","-|--","","","NCH"],
                  ["M2","^Y$","-|--","","","PCH"],
                  ["M1","^(AN|A)$","-|--","","",""]
              ]
          },
          "afterRoute"  : {
              "addPortOnRects" : [ ["YN","M1","xb2_1:D"] ]
          },
          "afterPaint" : { "resetOrigin" : 1 }
        }






