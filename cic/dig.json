                  ["BN","M1","MP2:G"]
              ]
          }
        },

        { "name": "EOX1_CV",
          "class" : "Layout::LayoutDigitalCell",
          "composite" : 1,
          "description" : "Exclusive OR",
          //- Known wart: the A route lifts the XA1 gate to M3, and the
          //- cut_M1M3 enclosure on the 3.0 um gate strap leaves two
          //- met1.2 markers magic reports and no measured pair explains
          //- (every neighbour is at 0.4 um or more). Every M2 corridor
          //- is taken by AN, BN and B, so the route stays on M3 until
          //- someone reworks the cell. LVS is clean: TOP flat LVS reads
          //- "Circuits match uniquely"
          "beforeRoute" : {
              "addDirectedRoutes" : [
                  //["M1","BN","XA2:MP0:D-|--XA3:BN"],
                  ["M2","A","XA1:A--|-XA3:A"],
                  //["M1","BN","XA3:MN3:G-|--XA2:MN0:D"],
                  ["M1","AN","XA3:AN--|-XA1:Y","offsethighend"]
                  //["M2","B","XA2:MN0:G-|--XA3:MN2:G"],
                  //["M2","B","XA2:MP0:G-|--XA3:MP3:G"]
              ],
              "addConnectivityRoutes" : [
                  ["M1","^BN$","--|-","onTopR"],
                  ["M2","^B$","-|--","onTopB"]

              ]
          }
        },

