        //------------------------------------------------------------

        { "name": "EONX1_CV",
          "class" : "Layout::LayoutDigitalCell",
          "description" : "Exclusive OR core, wants both polarities of both inputs",
          "setYoffsetHalf" : "",
          "rows" : 4,
          "beforeRoute" : {
              "addDirectedRoutes" : [
                  ["PO","A","MN1:G-MP1:G"],
                  ["PO","B","MN3:G-MP3:G"],
                  ["PO","BN","MN2:G-MP2:G"],
                  ["PO","A","MN4:G-MP4:G"],
                  //["M1","N1","MN1:D||MN2:S"],
                  //["M1","Y","MN2:D||MN3:S"],
                  //["M1","N3","MN3:D||MN4:S"],
                  ["M1","NP1","MP1:D||MP2:S"],
                  //["M1","AVDD","MP2:D||MP3:S"],
                  ["M1","NP2","MP3:D||MP4:S"]
                  //["M2","Y","MN2:D-|--MP1:S"],
                  //["M2","Y","MN2:D-|--MP4:D"]
              ],
              "addConnectivityRoutes" : [
                  ["M1","^Y$","-|--","onTopL"],
                  ["M1","^N1$","--|-","onTopL"],
                  ["M2","^N3$","-|--","onTopL"]

              ]
          },
          "afterRoute"  : {
              "addPortOnRects" : [
